{
  "name": "@endfield-ui/react",
  "version": "1.2.0",
  "description": "终末地风格的 React 基础控件库（非官方）",
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "base-ui",
    "endfield",
    "arknights"
  ],
  "license": "MIT",
  "author": "球球 (https://github.com/icaruszezen)",
  "homepage": "https://icaruszezen.github.io/endfield-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icaruszezen/endfield-ui.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/icaruszezen/endfield-ui/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/test",
    "!src/game",
    "!src/**/*.md",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./src/styles/index.css",
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./utilities.css": "./src/styles/utilities.css",
    "./game": {
      "types": "./dist/game.d.ts",
      "default": "./dist/game.js"
    },
    "./game.css": "./dist/game/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && pnpm build:css && pnpm build:game",
    "build:css": "node scripts/build-css.mjs src/styles/index.css dist/styles.css",
    "build:game": "node scripts/build-css.mjs src/game/styles.css dist/game/styles.css && node scripts/copy-game-assets.mjs",
    "test": "vitest run",
    "test:package": "node --test scripts/package.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"for (const f of ['LICENSE', 'NOTICE.md']) fs.copyFileSync('../../' + f, f)\"",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm test:package"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.64.12",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
