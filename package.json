{
  "name": "endfield-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @endfield-ui/docs dev",
    "dev:site": "pnpm --filter @endfield-ui/site dev",
    "build": "pnpm --filter @endfield-ui/react build",
    "build:docs": "pnpm --filter @endfield-ui/docs build",
    "build:site": "pnpm --filter @endfield-ui/site build",
    "check:docs": "pnpm --filter @endfield-ui/site check",
    "test": "pnpm --filter @endfield-ui/react test",
    "test:package": "pnpm --filter @endfield-ui/react test:package",
    "test:browser": "pnpm --filter @endfield-ui/docs test:browser",
    "test:site": "pnpm --filter @endfield-ui/site test:browser",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10"
  }
}
