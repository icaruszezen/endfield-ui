{
  "name": "endfield-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @endfield-ui/docs dev",
    "build": "pnpm --filter @endfield-ui/react build",
    "build:docs": "pnpm --filter @endfield-ui/docs build",
    "test": "pnpm --filter @endfield-ui/react test",
    "test:browser": "pnpm --filter @endfield-ui/docs test:browser",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9"
  }
}
